# Copy to backend/.env and replace every placeholder locally; never commit real secrets.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=REPLACE_WITH_RANDOM_LONG_SECRET_AT_LEAST_32_BYTES
FRONTEND_URL=http://localhost:5173
# When deployed, restrict to your HTTPS frontend (comma-separated if multiple).
FRONTEND_ORIGINS=http://localhost:5173
# Password reset email needs a configured Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
